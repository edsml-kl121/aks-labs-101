# Copy this file to config.env and adjust values before running any scripts:
#   cp config.env.example config.env
#
# Then source it in your shell before running the lab scripts:
#   source config.env

# Name of the resource group that will hold all lab resources.
export RG_NAME="myresourcegroup"

# Azure region to deploy into. Must support availability zones.
# Run scripts/00-check-prerequisites.sh to list valid regions.
export LOCATION="eastus"

# Name given to the AKS cluster created by scripts/03-create-aks-cluster.sh
export AKS_CLUSTER_NAME="myakscluster"

# VM size used by the system and user node pools.
export NODE_VM_SIZE="Standard_D4s_v3"

# Optional Azure OpenAI settings used by scripts/07-connect-azure-openai.sh.
# Leave the account name empty to generate a stable, globally unique name.
export AOAI_ACCOUNT_NAME=""
export AOAI_MODEL_NAME="gpt-5.4-mini"
export AOAI_MODEL_VERSION="2026-03-17"
export AOAI_MODEL_DEPLOYMENT="gpt-5.4-mini"
export AOAI_MODEL_CAPACITY="1"
export AOAI_API_VERSION="2024-12-01-preview"
